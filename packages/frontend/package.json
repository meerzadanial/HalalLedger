{
  "name": "@halalornot/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HalalOrNot Frontend Web Application",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:report": "vitest run BulkReportPanel api",
    "test:integration": "vitest run integration",
    "test:browser": "playwright test",
    "test:ci:targeted": "vitest run src/components/BulkReportPanel.test.tsx src/services/api.test.ts src/pages/DashboardPage.test.tsx src/pages/DashboardPage.integration.test.tsx",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-check": "4.9.0",
    "jsdom": "^23.2.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.1",
    "vitest": "^3.2.7"
  }
}
