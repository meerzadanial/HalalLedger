# Bulk CSV report email provider (required by the report worker)
# Supply secrets through your deployment secret manager; never commit real values.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REPORT_FROM_EMAIL=
REPORT_PUBLIC_WEBHOOK_URL=

# Provider adapter contract: disabled by default and never used by CI.
# The staging command hard-codes Resend's non-user test recipient delivered@resend.dev.
RUN_RESEND_SANDBOX_CONTRACT=false
RESEND_SANDBOX_STAGE=

# Bulk report worker and durable job settings
REPORT_ATTACHMENT_LIMIT_BYTES=10485760
REPORT_JOB_LEASE_MS=60000
REPORT_JOB_INITIAL_BACKOFF_MS=1000
REPORT_JOB_MAX_BACKOFF_MS=300000
REPORT_JOB_MAX_ATTEMPTS=8
REPORT_WORKER_ID=
REPORT_WORKER_POLL_INTERVAL_MS=1000
REPORT_WORKER_HEARTBEAT_MAX_AGE_MS=120000
REPORT_ATTACHMENT_RETENTION_DAYS=7
REPORT_RETENTION_SWEEP_INTERVAL_MS=3600000

# Metric-derived operational alert thresholds
REPORT_ALERT_STALE_LEASE_COUNT=1
REPORT_ALERT_FAILURE_SPIKE_COUNT=5
REPORT_ALERT_INVALID_SIGNATURE_SPIKE_COUNT=5
REPORT_ALERT_APPROACHING_DEADLINE_COUNT=1
REPORT_ALERT_APPROACHING_DEADLINE_SECONDS=60
